<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Status do Ambiente | {{ cloud_provider | upper }}</title>
    <style>
        * { box-sizing: border-box; }
        body {
            margin: 0;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            color: #fff;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 1rem;
        }
        .gradient-bg {
            /* Gradiente dinâmico: Azul para Azure, Laranja/Roxo para AWS */
            background: {{ 'linear-gradient(135deg, #0078d4, #00182b)' if cloud_provider == 'azure' else 'linear-gradient(135deg, #ff9900, #3b0764)' }};
        }
        .glass-card {
            width: 100%;
            max-width: 42rem;
            background: rgba(255, 255, 255, 0.1);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.2);
            border-radius: 1rem;
            box-shadow: 0 25px 50px -12px rgb(0 0 0 / 0.25);
            padding: 2rem;
            text-align: center;
            transition: transform 0.5s;
        }
        .glass-card:hover { transform: scale(1.05); }
        @media (min-width: 768px) {
            .glass-card { padding: 3rem; }
        }
        .badge {
            display: inline-block;
            color: #fff;
            font-size: 0.875rem;
            font-weight: 700;
            padding: 0.5rem 1.5rem;
            border-radius: 9999px;
            margin-bottom: 1rem;
            box-shadow: 0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1);
        }
        .badge-azure { background: #2563eb; }
        .badge-aws { background: #f97316; }
        header { margin-bottom: 2rem; }
        h1 {
            font-size: 2.25rem;
            font-weight: 700;
            letter-spacing: -0.025em;
            margin: 0;
        }
        @media (min-width: 768px) {
            h1 { font-size: 3rem; }
        }
        .subtitle { color: #dbeafe; margin: 0.5rem 0 0; }
        main {
            text-align: left;
            background: rgba(0, 0, 0, 0.2);
            padding: 1.5rem;
            border-radius: 0.5rem;
            border: 1px solid rgba(255, 255, 255, 0.2);
        }
        h2 {
            font-size: 1.25rem;
            font-weight: 700;
            margin: 0 0 1rem;
            border-bottom: 1px solid rgba(255, 255, 255, 0.2);
            padding-bottom: 0.5rem;
        }
        .details-row {
            display: flex;
            justify-content: space-between;
            padding-top: 0.5rem;
            margin-top: 0.75rem;
            border-top: 1px solid rgba(255, 255, 255, 0.05);
        }
        .details-row:first-child {
            padding-top: 0;
            margin-top: 0;
            border-top: none;
        }
        .details-label { font-weight: 600; color: #fff; }
        .details-value { color: #dbeafe; }
        .status-online { color: #4ade80; font-weight: 700; }
        .details-link { color: #93c5fd; text-decoration: none; transition: color 0.15s; }
        .details-link:hover { color: #fff; text-decoration: underline; }
        footer { margin-top: 2rem; }
        footer p { font-size: 0.75rem; color: #bfdbfe; }
    </style>
</head>
<body class="gradient-bg">

    <div class="glass-card">

        <header>
            <div class="badge {{ 'badge-azure' if cloud_provider == 'azure' else 'badge-aws' }}">
                {{ cloud_provider | upper }} - AMBIENTE {{ environment_name | upper }}
            </div>
            <h1>Framework de Automação IaC</h1>
            <p class="subtitle">Provisionamento e Configuração Multicloud</p>
        </header>

        <main>
            <h2>Detalhes do Servidor</h2>
            <div>
                <div class="details-row">
                    <span class="details-label">Provedor Cloud:</span>
                    <span class="details-label">{{ cloud_provider | upper }}</span>
                </div>
                <div class="details-row">
                    <span class="details-label">Hostname:</span>
                    <span class="details-value">{{ ansible_hostname }}</span>
                </div>
                <div class="details-row">
                    <span class="details-label">IP Privado:</span>
                    <span class="details-value">{{ ansible_default_ipv4.address }}</span>
                </div>
                <div class="details-row">
                    <span class="details-label">Status do Deploy:</span>
                    <span class="status-online">● ONLINE</span>
                </div>
                <div class="details-row">
                    <span class="details-label">URL Oficial:</span>
                    <a href="https://{{ environment_name }}-{{ cloud_provider }}.alissonlima.dev.br"
                       class="details-link">
                       {{ environment_name }}-{{ cloud_provider }}.alissonlima.dev.br
                    </a>
                </div>
            </div>
        </main>

        <footer>
            <p>Projeto de TCC - Alisson Lima - 2026</p>
        </footer>

    </div>

    <script>
        // Script para exibir o timestamp do deploy
        console.log("Servidor {{ ansible_hostname }} carregado em: " + new Date().toISOString());
    </script>

</body>
</html>
