# =====================================================================
# ENVIRONMENTS/PROD/TERRAFORM.TFVARS.EXAMPLE - TEMPLATE (SEM VALORES REAIS)
# =====================================================================
# Copie este arquivo para terraform.tfvars e preencha com seus valores.
# terraform.tfvars é ignorado pelo Git (.gitignore) e nunca deve ser commitado.

environment_name = "prod"

vpc_cidr_block   = "10.70.0.0/16"

instance_type    = "t3.micro"

# Seu IP público para acesso administrativo via Bastion (formato CIDR /32)
my_ip            = "YOUR_IP_ADDRESS/32"

app_server_count = 2

tags = {
  Project   = "TCC-AlissonLima"
  ManagedBy = "Terraform"
  Env       = "prod"
}

# --- Variáveis Adicionais (Centralizadas no Ambiente) ---
key_name = "your-aws-key-pair-name"
